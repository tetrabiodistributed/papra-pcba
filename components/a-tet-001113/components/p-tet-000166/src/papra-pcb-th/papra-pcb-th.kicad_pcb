	(gr_text "Changelog\n\nv0.2\n- BATTERY Tabs swapped (polarity, same position)\n- SMT Components Moved, won't affect mechanical\n- D1 package changed (was SMB, is SMA)\n\nv0.3 changelog (see schematic for signal changes)\n\n- Added mounting hole\n- Added fuse, moved SMT components to fit\n- Adjustments for JLC DRU, pad override was 40%, reduced to 25%\n- Silk cleanup\n- Changed Battery Tab package to round pads (was square)\n\nv0.4\n- Board is 2mm wider on right side\n- DC power out is now BNC\n\nv0.5\n- Added buzzer\n\nv0.6\n- See schematic changes\n\nv0.7\n- Board grew 3mm wider\n- Buzzer & components adjacent moved to make room for electrolytic\n\nv0.7.1\n- Added OSHW to bottom silk\n\nv0.7.2\n- Adding tooling holes for assembly\n- Silk tweaks for battery polarity"
		(at 174.4801 65.2306 0)
		(layer "Cmts.User")
		(uuid "cb6dd073-b49c-4274-9b2a-7004dd468b37")
		(effects
			(font
				(size 1.63576 1.63576)
				(thickness 0.14224)
			)
			(justify left top)
		)
	)
